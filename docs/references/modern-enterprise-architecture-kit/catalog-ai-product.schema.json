{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalog AI Product",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "kind",
    "owner",
    "lifecycle",
    "riskTier",
    "source",
    "runtime",
    "scorecard"
  ],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "kind": { "type": "string", "enum": ["ai-product"] },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "lifecycle": { "type": "string", "enum": ["draft", "beta", "production", "deprecated"] },
    "riskTier": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5"] },
    "source": {
      "type": "object",
      "required": ["aiProductPath", "contractPath"],
      "properties": {
        "aiProductPath": { "type": "string", "minLength": 1 },
        "contractPath": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["gatewayRoute", "ragIndex", "toolRegistry"],
      "properties": {
        "gatewayRoute": { "type": "string", "minLength": 1 },
        "ragIndex": { "type": "string", "pattern": "^vector:[a-z0-9-]+:v[0-9]+$" },
        "toolRegistry": { "type": "string", "minLength": 1 }
      }
    },
    "scorecard": { "type": "string", "minLength": 1 }
  }
}
