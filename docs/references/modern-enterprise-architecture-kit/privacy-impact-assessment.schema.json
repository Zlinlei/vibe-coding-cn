{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "assessment",
    "dataProduct",
    "domain",
    "owner",
    "classification",
    "lawfulBasis",
    "processing",
    "aiUse",
    "dataSubjectRights",
    "deletion",
    "controls",
    "review"
  ],
  "properties": {
    "assessment": {
      "type": "string",
      "minLength": 1
    },
    "dataProduct": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "piiFields"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "piiFields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lawfulBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "consentRequired", "purpose"],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "consentRequired": {
          "type": "boolean"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations", "retention", "processors"],
      "properties": {
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retention": {
          "type": "string",
          "minLength": 1
        },
        "processors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "aiUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "disallowed", "trainingOptOutRequired"],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disallowed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "trainingOptOutRequired": {
          "type": "boolean"
        }
      }
    },
    "dataSubjectRights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "deletion", "correction", "portability"],
      "properties": {
        "access": {
          "type": "boolean"
        },
        "deletion": {
          "type": "boolean"
        },
        "correction": {
          "type": "boolean"
        },
        "portability": {
          "type": "boolean"
        }
      }
    },
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectDeleteSlaDays", "vectorIndex", "propagationEvidence"],
      "properties": {
        "subjectDeleteSlaDays": {
          "type": "integer",
          "minimum": 1
        },
        "vectorIndex": {
          "type": "string",
          "minLength": 1
        },
        "propagationEvidence": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimization", "encryption", "accessReview", "auditLogging", "subjectDeletePropagation"],
      "properties": {
        "minimization": {
          "type": "boolean"
        },
        "encryption": {
          "type": "boolean"
        },
        "accessReview": {
          "type": "boolean"
        },
        "auditLogging": {
          "type": "boolean"
        },
        "subjectDeletePropagation": {
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dpiaRequired", "approved", "approver", "reviewedOn", "nextReviewOn"],
      "properties": {
        "dpiaRequired": {
          "type": "boolean"
        },
        "approved": {
          "type": "boolean"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "reviewedOn": {
          "type": "string",
          "format": "date"
        },
        "nextReviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
