{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "API Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "api",
    "domain",
    "owner",
    "producerService",
    "version",
    "protocol",
    "spec",
    "auth",
    "compatibility",
    "consumers"
  ],
  "properties": {
    "api": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-api$" },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "producerService": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-service$" },
    "version": { "type": "string", "pattern": "^v[0-9]+$" },
    "protocol": { "type": "string", "enum": ["openapi", "graphql", "grpc"] },
    "spec": { "type": "string", "minLength": 1 },
    "auth": {
      "type": "object",
      "required": ["type", "scope"],
      "properties": {
        "type": { "type": "string", "enum": ["oauth2", "mtls", "iam", "none"] },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "required": ["breakingChangePolicy", "deprecationPolicy"],
      "properties": {
        "breakingChangePolicy": { "type": "string", "minLength": 1 },
        "deprecationPolicy": { "type": "string", "minLength": 1 }
      }
    },
    "consumers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
