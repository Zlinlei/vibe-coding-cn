{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline Change Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record",
    "version",
    "previousVersion",
    "changeLevel",
    "status",
    "owner",
    "requestedBy",
    "requestedOn",
    "approvedOn",
    "scope",
    "impact",
    "validation",
    "rollback",
    "approvals",
    "retention"
  ],
  "properties": {
    "record": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "previousVersion": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "changeLevel": {
      "type": "string",
      "enum": [
        "Patch",
        "Minor",
        "Major",
        "Breaking"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "approved",
        "implemented",
        "rejected"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1
    },
    "requestedOn": {
      "type": "string",
      "format": "date"
    },
    "approvedOn": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureDocument",
        "versionManifest",
        "controlCatalog",
        "controlCount",
        "starterKitPairs",
        "changedArtifacts"
      ],
      "properties": {
        "architectureDocument": {
          "type": "string",
          "minLength": 1
        },
        "versionManifest": {
          "type": "string",
          "minLength": 1
        },
        "controlCatalog": {
          "type": "string",
          "minLength": 1
        },
        "controlCount": {
          "type": "integer",
          "minimum": 1
        },
        "starterKitPairs": {
          "type": "integer",
          "minimum": 1
        },
        "changedArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "security",
        "privacy",
        "data",
        "ai",
        "availability",
        "compatibility"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "security": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "privacy": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "data": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "ai": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "availability": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "compatibility": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "commands",
        "evidence"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported",
        "previousCommit",
        "plan",
        "owner"
      ],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "previousCommit": {
          "type": "string",
          "minLength": 7
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "approver",
          "status",
          "approvedOn"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "approver": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "approvedOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "reviewOn"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "reviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
