{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitOps Deployment Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deployment",
    "environment",
    "domain",
    "service",
    "namespace",
    "image",
    "replicas",
    "resources",
    "strategy",
    "serviceAccount",
    "security",
    "scaling",
    "availability",
    "configRefs",
    "policy"
  ],
  "properties": {
    "deployment": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-service$"
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "staging",
        "prod"
      ]
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-service$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "replicas": {
      "type": "integer"
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": [
        "type",
        "maxUnavailable"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "rolling",
            "canary",
            "blue-green"
          ]
        },
        "maxUnavailable": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "string",
      "minLength": 1
    },
    "security": {
      "type": "object",
      "required": [
        "podSecurity",
        "networkPolicy",
        "imageVerificationPolicy"
      ],
      "properties": {
        "podSecurity": {
          "type": "string",
          "minLength": 1
        },
        "networkPolicy": {
          "type": "string",
          "minLength": 1
        },
        "imageVerificationPolicy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "scaling": {
      "type": "object",
      "required": [
        "hpa",
        "minReplicas",
        "maxReplicas",
        "metric"
      ],
      "properties": {
        "hpa": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer"
        },
        "maxReplicas": {
          "type": "integer"
        },
        "metric": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": [
        "podDisruptionBudget",
        "multiZone"
      ],
      "properties": {
        "podDisruptionBudget": {
          "type": "string",
          "minLength": 1
        },
        "multiZone": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "configRefs": {
      "type": "object",
      "required": [
        "configMaps",
        "secrets"
      ],
      "properties": {
        "configMaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "requiresSignedImage",
        "requiresProvenance",
        "requiresSbom"
      ],
      "properties": {
        "requiresSignedImage": {
          "type": "boolean"
        },
        "requiresProvenance": {
          "type": "boolean"
        },
        "requiresSbom": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
