{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitOps Deployment Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "deployment",
    "environment",
    "domain",
    "service",
    "namespace",
    "image",
    "replicas",
    "resources",
    "strategy",
    "policy"
  ],
  "properties": {
    "deployment": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-service$" },
    "environment": { "type": "string", "enum": ["dev", "staging", "prod"] },
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "service": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-service$" },
    "namespace": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "replicas": { "type": "integer" },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"], "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } },
        "limits": { "type": "object", "required": ["cpu", "memory"], "properties": { "cpu": { "type": "string" }, "memory": { "type": "string" } } }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["type", "maxUnavailable"],
      "properties": {
        "type": { "type": "string", "enum": ["rolling", "canary", "blue-green"] },
        "maxUnavailable": { "type": "string", "minLength": 1 }
      }
    },
    "policy": {
      "type": "object",
      "required": ["requiresSignedImage", "requiresProvenance", "requiresSbom"],
      "properties": {
        "requiresSignedImage": { "type": "boolean" },
        "requiresProvenance": { "type": "boolean" },
        "requiresSbom": { "type": "boolean" }
      }
    }
  }
}
