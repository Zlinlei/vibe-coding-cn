{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Readiness Gate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gate",
    "owner",
    "appliesTo",
    "requiredEvidence",
    "blockingRules",
    "expiry"
  ],
  "properties": {
    "gate": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requiredEvidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "blockingRules": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expiry": { "type": "string", "format": "date" }
  }
}
