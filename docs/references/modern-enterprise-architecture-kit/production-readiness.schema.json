{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Readiness Gate",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "gate",
    "owner",
    "appliesTo",
    "requiredEvidence",
    "blockingRules",
    "waiverPolicy",
    "verification",
    "expiry"
  ],
  "properties": {
    "gate": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "appliesTo": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "requiredEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence", "source", "blocking"],
        "properties": {
          "evidence": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "blockingRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule", "severity", "message"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "enum": ["warn", "block"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "waiverPolicy": {
      "type": "object",
      "required": ["allowed", "requiresException", "maxDays"],
      "properties": {
        "allowed": { "type": "boolean" },
        "requiresException": { "type": "string", "minLength": 1 },
        "maxDays": { "type": "integer" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["command", "report"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "report": { "type": "string", "minLength": 1 }
      }
    },
    "expiry": { "type": "string", "format": "date" }
  }
}
