{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control Evidence Map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "map",
    "version",
    "owner",
    "generatedOn",
    "controlCount",
    "freshness",
    "controls"
  ],
  "properties": {
    "map": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "generatedOn": {
      "type": "string",
      "format": "date"
    },
    "controlCount": {
      "type": "integer",
      "minimum": 1
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAgeDays",
        "expiryAction"
      ],
      "properties": {
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "expiryAction": {
          "type": "string",
          "enum": [
            "block"
          ]
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence",
          "status",
          "required",
          "fresh",
          "blocking"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CTRL-[A-Z0-9-]+$"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "type",
                "source",
                "verifiedOn"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "verifiedOn": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "fresh": {
            "type": "boolean"
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
