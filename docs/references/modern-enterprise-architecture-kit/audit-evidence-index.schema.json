{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Evidence Index",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "evidence",
    "type",
    "owner",
    "subject",
    "location",
    "retention",
    "relatedVersion",
    "reviewDate"
  ],
  "properties": {
    "evidence": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "type": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "subject": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "retention": { "type": "string", "minLength": 1 },
    "relatedVersion": { "type": "string", "pattern": "^V\\d+\\.\\d+$" },
    "reviewDate": { "type": "string", "format": "date" }
  }
}
