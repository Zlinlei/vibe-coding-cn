{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lineageEvent",
    "dataProduct",
    "domain",
    "owner",
    "outputDataProduct",
    "producerJob",
    "run",
    "inputs",
    "outputs",
    "facets",
    "backend"
  ],
  "properties": {
    "lineageEvent": {
      "type": "string",
      "minLength": 1
    },
    "dataProduct": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "outputDataProduct": {
      "type": "string",
      "minLength": 1
    },
    "producerJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "name"],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "state", "eventTime"],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": ["START", "RUNNING", "COMPLETE", "FAIL", "ABORT"]
        },
        "eventTime": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "name"],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["namespace", "name"],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "quality", "producer"],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "quality": {
          "type": "string",
          "minLength": 1
        },
        "producer": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["openlineage", "datahub", "openmetadata", "internal"]
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
