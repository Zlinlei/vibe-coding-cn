{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reliability Tiering Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "availabilityTarget",
    "rto",
    "rpo",
    "onCall",
    "drillCadence",
    "errorBudgetPolicy"
  ],
  "properties": {
    "tier": {
      "type": "string",
      "enum": [
        "tier-1",
        "tier-2",
        "tier-3"
      ]
    },
    "availabilityTarget": {
      "type": "string"
    },
    "rto": {
      "type": "string"
    },
    "rpo": {
      "type": "string"
    },
    "onCall": {
      "type": "string"
    },
    "drillCadence": {
      "type": "string"
    },
    "errorBudgetPolicy": {
      "type": "object",
      "required": [
        "attentionAt",
        "restrictAt",
        "freezeAt"
      ],
      "properties": {
        "attentionAt": {
          "type": "string",
          "pattern": "^\\d+%$"
        },
        "restrictAt": {
          "type": "string",
          "pattern": "^\\d+%$"
        },
        "freezeAt": {
          "type": "string",
          "pattern": "^\\d+%$"
        }
      },
      "additionalProperties": false
    }
  }
}
