{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POA&M Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "poam",
    "version",
    "owner",
    "generatedOn",
    "scope",
    "items",
    "milestones",
    "signOff",
    "retention"
  ],
  "properties": {
    "poam": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "generatedOn": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureVersion",
        "controlAssessmentReport",
        "openFindings",
        "blockingFindings",
        "status"
      ],
      "properties": {
        "architectureVersion": {
          "type": "string",
          "pattern": "^V\\d+\\.\\d+$"
        },
        "controlAssessmentReport": {
          "type": "string",
          "minLength": 1
        },
        "openFindings": {
          "type": "integer",
          "minimum": 0
        },
        "blockingFindings": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "enum": [
            "open-items",
            "no-open-items"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "controlId",
          "severity",
          "status",
          "owner",
          "action",
          "dueDate",
          "evidence"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "controlId": {
            "type": "string",
            "pattern": "^CTRL-[A-Z0-9-]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "mitigated",
              "closed"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "closedOn": {
            "type": "string",
            "format": "date"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "milestone",
          "finding",
          "status",
          "dueDate"
        ],
        "properties": {
          "milestone": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "finding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "in-progress",
              "complete"
            ]
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "completedOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approver",
        "signedOn",
        "nextReviewOn"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "signedOn": {
          "type": "string",
          "format": "date"
        },
        "nextReviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "reviewOn"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "reviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
