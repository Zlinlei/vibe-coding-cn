{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "platformProduct",
    "owner",
    "platformPm",
    "period",
    "goldenPath",
    "metrics",
    "slo",
    "feedback",
    "actions",
    "scorecard"
  ],
  "properties": {
    "platformProduct": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "platformPm": {
      "type": "string",
      "minLength": 1
    },
    "period": {
      "type": "string",
      "pattern": "^20[0-9]{2}-Q[1-4]$"
    },
    "goldenPath": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoptionRate",
        "developerSatisfaction",
        "cognitiveLoadScore",
        "leadTimeP50",
        "changeFailureRate",
        "selfServiceCompletionRate",
        "supportTicketDeflection"
      ],
      "properties": {
        "adoptionRate": {
          "type": "string",
          "minLength": 1
        },
        "developerSatisfaction": {
          "type": "string",
          "minLength": 1
        },
        "cognitiveLoadScore": {
          "type": "string",
          "minLength": 1
        },
        "leadTimeP50": {
          "type": "string",
          "minLength": 1
        },
        "changeFailureRate": {
          "type": "string",
          "minLength": 1
        },
        "selfServiceCompletionRate": {
          "type": "string",
          "minLength": 1
        },
        "supportTicketDeflection": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portalAvailability", "scaffoldSuccessRate"],
      "properties": {
        "portalAvailability": {
          "type": "number"
        },
        "scaffoldSuccessRate": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["survey", "topFriction"],
      "properties": {
        "survey": {
          "type": "string",
          "minLength": 1
        },
        "topFriction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "owner", "dueDate"],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "scorecard": {
      "type": "string",
      "minLength": 1
    }
  }
}
