{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Product Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aiProduct",
    "owner",
    "lifecycle",
    "riskTier",
    "businessGoal",
    "model",
    "prompts",
    "rag",
    "tools",
    "evals",
    "guardrails",
    "observability",
    "slo",
    "budget",
    "fallback",
    "providerPolicy",
    "dataUsePolicy",
    "runbook"
  ],
  "properties": {
    "aiProduct": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "pattern": "^team-[a-z0-9-]+$"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "beta",
        "production",
        "deprecated"
      ]
    },
    "riskTier": {
      "type": "string",
      "enum": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ]
    },
    "businessGoal": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "required": [
        "gatewayRoute",
        "approvedModel",
        "modelVersion"
      ],
      "properties": {
        "gatewayRoute": {
          "type": "string",
          "minLength": 1
        },
        "approvedModel": {
          "type": "string",
          "minLength": 1
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "prompts": {
      "type": "object",
      "required": [
        "system"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rag": {
      "type": "object",
      "required": [
        "sources",
        "vectorIndex"
      ],
      "properties": {
        "sources": {
          "type": "string",
          "minLength": 1
        },
        "vectorIndex": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "riskLevel",
          "requiresHumanApproval"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "riskLevel": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "requiresHumanApproval": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "evals": {
      "type": "object",
      "required": [
        "regression",
        "redTeam"
      ],
      "properties": {
        "regression": {
          "type": "string",
          "minLength": 1
        },
        "redTeam": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "required": [
        "policy"
      ],
      "properties": {
        "policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": [
        "traceRetentionDays",
        "replayEnabled"
      ],
      "properties": {
        "traceRetentionDays": {
          "type": "integer"
        },
        "replayEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "slo": {
      "type": "object",
      "required": [
        "taskCompletionRate",
        "groundedAnswerRate",
        "toolErrorRate",
        "p95LatencyMs"
      ],
      "properties": {
        "taskCompletionRate": {
          "type": "string",
          "minLength": 1
        },
        "groundedAnswerRate": {
          "type": "string",
          "minLength": 1
        },
        "toolErrorRate": {
          "type": "string",
          "minLength": 1
        },
        "p95LatencyMs": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "monthlyUsd",
        "costPerSuccessfulTaskUsd",
        "owner"
      ],
      "properties": {
        "monthlyUsd": {
          "type": "integer"
        },
        "costPerSuccessfulTaskUsd": {
          "type": "number"
        },
        "owner": {
          "type": "string",
          "pattern": "^team-[a-z0-9-]+$"
        }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": [
        "degradedMode",
        "humanHandoff",
        "rollbackPrompt"
      ],
      "properties": {
        "degradedMode": {
          "type": "string",
          "minLength": 1
        },
        "humanHandoff": {
          "type": "string",
          "minLength": 1
        },
        "rollbackPrompt": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "providerPolicy": {
      "type": "object",
      "required": [
        "logRetention",
        "dataTrainingOptOut",
        "crossBorderReview"
      ],
      "properties": {
        "logRetention": {
          "type": "string",
          "minLength": 1
        },
        "dataTrainingOptOut": {
          "type": "boolean"
        },
        "crossBorderReview": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "dataUsePolicy": {
      "type": "object",
      "required": [
        "allowed",
        "disallowed"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disallowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "runbook": {
      "type": "object",
      "required": [
        "incident",
        "rollback"
      ],
      "properties": {
        "incident": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
