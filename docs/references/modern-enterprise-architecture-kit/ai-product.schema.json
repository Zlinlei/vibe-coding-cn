{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Product Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "aiProduct",
    "owner",
    "lifecycle",
    "riskTier",
    "businessGoal",
    "model",
    "prompts",
    "rag",
    "tools",
    "evals",
    "guardrails",
    "observability",
    "slo",
    "budget",
    "fallback",
    "providerPolicy",
    "dataUsePolicy",
    "runbook"
  ],
  "properties": {
    "aiProduct": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "lifecycle": { "type": "string", "enum": ["draft", "beta", "production", "deprecated"] },
    "riskTier": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5"] },
    "businessGoal": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["gatewayRoute", "approvedModel", "modelVersion"],
      "properties": {
        "gatewayRoute": { "type": "string", "minLength": 1 },
        "approvedModel": { "type": "string", "minLength": 1 },
        "modelVersion": { "type": "string", "minLength": 1 }
      }
    },
    "prompts": {
      "type": "object",
      "required": ["system"],
      "properties": { "system": { "type": "string", "minLength": 1 } }
    },
    "rag": {
      "type": "object",
      "required": ["sources", "vectorIndex"],
      "properties": {
        "sources": { "type": "string", "minLength": 1 },
        "vectorIndex": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tool", "riskLevel", "requiresHumanApproval"],
        "properties": {
          "tool": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "riskLevel": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "requiresHumanApproval": { "type": "boolean" }
        }
      }
    },
    "evals": {
      "type": "object",
      "required": ["regression", "redTeam"],
      "properties": {
        "regression": { "type": "string", "minLength": 1 },
        "redTeam": { "type": "string", "minLength": 1 }
      }
    },
    "guardrails": {
      "type": "object",
      "required": ["policy"],
      "properties": { "policy": { "type": "string", "minLength": 1 } }
    },
    "observability": {
      "type": "object",
      "required": ["traceRetentionDays", "replayEnabled"],
      "properties": {
        "traceRetentionDays": { "type": "integer" },
        "replayEnabled": { "type": "boolean" }
      }
    },
    "slo": {
      "type": "object",
      "required": ["taskCompletionRate", "groundedAnswerRate", "toolErrorRate", "p95LatencyMs"],
      "properties": {
        "taskCompletionRate": { "type": "string", "minLength": 1 },
        "groundedAnswerRate": { "type": "string", "minLength": 1 },
        "toolErrorRate": { "type": "string", "minLength": 1 },
        "p95LatencyMs": { "type": "integer" }
      }
    },
    "budget": {
      "type": "object",
      "required": ["monthlyUsd", "costPerSuccessfulTaskUsd", "owner"],
      "properties": {
        "monthlyUsd": { "type": "integer" },
        "costPerSuccessfulTaskUsd": { "type": "number" },
        "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" }
      }
    },
    "fallback": {
      "type": "object",
      "required": ["degradedMode", "humanHandoff", "rollbackPrompt"],
      "properties": {
        "degradedMode": { "type": "string", "minLength": 1 },
        "humanHandoff": { "type": "string", "minLength": 1 },
        "rollbackPrompt": { "type": "string", "minLength": 1 }
      }
    },
    "providerPolicy": {
      "type": "object",
      "required": ["logRetention", "dataTrainingOptOut", "crossBorderReview"],
      "properties": {
        "logRetention": { "type": "string", "minLength": 1 },
        "dataTrainingOptOut": { "type": "boolean" },
        "crossBorderReview": { "type": "string", "minLength": 1 }
      }
    },
    "dataUsePolicy": {
      "type": "object",
      "required": ["allowed", "disallowed"],
      "properties": {
        "allowed": { "type": "array", "items": { "type": "string" } },
        "disallowed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runbook": {
      "type": "object",
      "required": ["incident", "rollback"],
      "properties": {
        "incident": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      }
    }
  }
}
