{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Service Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "service",
    "domain",
    "owner",
    "lifecycle",
    "tier",
    "runtime",
    "resources",
    "dependencies",
    "slo",
    "reliability",
    "runbook",
    "rollback"
  ],
  "properties": {
    "service": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-service$"
    },
    "domain": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "owner": {
      "type": "string",
      "pattern": "^team-[a-z0-9-]+$"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "draft",
        "beta",
        "production",
        "deprecated"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "tier-1",
        "tier-2",
        "tier-3"
      ]
    },
    "runtime": {
      "type": "object",
      "required": [
        "type",
        "imageRepository",
        "ports",
        "health"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "kubernetes"
          ]
        },
        "imageRepository": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "object",
          "required": [
            "http"
          ],
          "properties": {
            "http": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "health": {
          "type": "object",
          "required": [
            "liveness",
            "readiness"
          ],
          "properties": {
            "liveness": {
              "type": "string",
              "pattern": "^/"
            },
            "readiness": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ],
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "apis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "object",
          "properties": {
            "publishes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "subscribes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "slo": {
      "type": "object",
      "required": [
        "availability",
        "latencyP95Ms"
      ],
      "properties": {
        "availability": {
          "type": "number"
        },
        "latencyP95Ms": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "reliability": {
      "type": "object",
      "required": [
        "rto",
        "rpo",
        "onCall",
        "errorBudgetPolicy",
        "drillEvidence"
      ],
      "properties": {
        "rto": {
          "type": "string",
          "minLength": 1
        },
        "rpo": {
          "type": "string",
          "minLength": 1
        },
        "onCall": {
          "type": "string",
          "minLength": 1
        },
        "errorBudgetPolicy": {
          "type": "string",
          "minLength": 1
        },
        "drillEvidence": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "runbook": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
