{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Domain Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "domain",
    "name",
    "owner",
    "lifecycle",
    "boundedContext",
    "capabilities",
    "sloTier",
    "architectureDecision"
  ],
  "properties": {
    "domain": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "lifecycle": { "type": "string", "enum": ["draft", "beta", "production", "deprecated"] },
    "boundedContext": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "upstream": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "downstream": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "sloTier": { "type": "string", "enum": ["tier-1", "tier-2", "tier-3"] },
    "dataClassification": { "type": "string" },
    "architectureDecision": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
