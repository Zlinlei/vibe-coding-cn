{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Compatibility Report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "report",
    "event",
    "owner",
    "previousVersion",
    "candidateVersion",
    "schema",
    "checks",
    "consumerImpact",
    "waiver",
    "decision",
    "generatedAt"
  ],
  "properties": {
    "report": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "event": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "previousVersion": { "type": "string", "pattern": "^v[0-9]+$" },
    "candidateVersion": { "type": "string", "pattern": "^v[0-9]+$" },
    "schema": { "type": "string", "minLength": 1 },
    "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "consumerImpact": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["consumer", "impact", "replayRequired"],
        "properties": {
          "consumer": { "type": "string", "minLength": 1 },
          "impact": { "type": "string", "minLength": 1 },
          "replayRequired": { "type": "boolean" }
        }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["required", "exception"],
      "properties": {
        "required": { "type": "boolean" },
        "exception": { "type": "string", "minLength": 1 }
      }
    },
    "decision": { "type": "string", "enum": ["pass", "fail", "waived"] },
    "generatedAt": { "type": "string", "format": "date" }
  }
}
