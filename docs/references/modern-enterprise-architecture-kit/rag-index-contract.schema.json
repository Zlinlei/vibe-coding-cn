{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Index Contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "indexId",
    "owner",
    "sources",
    "embeddingModel",
    "chunking",
    "accessControl",
    "refresh",
    "deletion"
  ],
  "properties": {
    "indexId": { "type": "string", "pattern": "^vector:[a-z0-9-]+:v[0-9]+$" },
    "owner": { "type": "string", "pattern": "^team-[a-z0-9-]+$" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "embeddingModel": { "type": "string", "minLength": 1 },
    "chunking": {
      "type": "object",
      "required": ["strategy", "maxTokens"],
      "properties": {
        "strategy": { "type": "string", "minLength": 1 },
        "maxTokens": { "type": "integer" }
      }
    },
    "accessControl": {
      "type": "object",
      "required": ["policy", "filterRequired"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "filterRequired": { "type": "boolean" }
      }
    },
    "refresh": {
      "type": "object",
      "required": ["cadence", "ownerApproval"],
      "properties": {
        "cadence": { "type": "string", "minLength": 1 },
        "ownerApproval": { "type": "boolean" }
      }
    },
    "deletion": {
      "type": "object",
      "required": ["supportsSubjectDelete", "retention"],
      "properties": {
        "supportsSubjectDelete": { "type": "boolean" },
        "retention": { "type": "string", "minLength": 1 }
      }
    }
  }
}
