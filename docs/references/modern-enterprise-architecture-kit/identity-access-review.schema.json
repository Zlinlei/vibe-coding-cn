{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["review", "service", "domain", "owner", "environment", "namespace", "identityProvider", "roles", "breakGlass", "evidence"],
  "properties": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewId", "reviewedOn", "nextReviewOn", "reviewer", "decision"],
      "properties": {
        "reviewId": {"type": "string", "minLength": 1},
        "reviewedOn": {"type": "string", "format": "date"},
        "nextReviewOn": {"type": "string", "format": "date"},
        "reviewer": {"type": "string", "minLength": 1},
        "decision": {"type": "string", "enum": ["pass", "warn", "fail"]}
      }
    },
    "service": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["dev", "staging", "prod"]},
    "namespace": {"type": "string", "minLength": 1},
    "identityProvider": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "scope", "subjects", "privileged", "lastReviewedOn"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "privileged": {"type": "boolean"},
          "lastReviewedOn": {"type": "string", "format": "date"}
        }
      }
    },
    "breakGlass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "account", "mfaRequired", "maxDurationHours", "auditLog"],
      "properties": {
        "enabled": {"type": "boolean"},
        "account": {"type": "string", "minLength": 1},
        "mfaRequired": {"type": "boolean"},
        "maxDurationHours": {"type": "integer", "minimum": 1, "maximum": 24},
        "auditLog": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "ticket"],
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "ticket": {"type": "string", "minLength": 1}
      }
    }
  }
}
