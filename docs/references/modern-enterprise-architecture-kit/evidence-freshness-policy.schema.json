{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "owner", "defaults", "evidenceTypes", "automation", "review"],
  "properties": {
    "policy": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxAgeDays", "expiryAction"],
      "properties": {
        "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 365},
        "expiryAction": {"type": "string", "enum": ["block", "warn", "notify"]}
      }
    },
    "evidenceTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "maxAgeDays", "required"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "maxAgeDays": {"type": "integer", "minimum": 1, "maximum": 365},
          "required": {"type": "boolean"}
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ciEnforced", "reportPath"],
      "properties": {
        "ciEnforced": {"type": "boolean"},
        "reportPath": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedOn", "nextReviewOn", "approver"],
      "properties": {
        "reviewedOn": {"type": "string", "format": "date"},
        "nextReviewOn": {"type": "string", "format": "date"},
        "approver": {"type": "string", "minLength": 1}
      }
    }
  }
}
