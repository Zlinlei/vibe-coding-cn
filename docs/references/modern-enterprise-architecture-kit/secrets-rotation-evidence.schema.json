{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence", "service", "domain", "owner", "environment", "namespace", "provider", "crypto", "rotation", "secrets", "exposure"],
  "properties": {
    "evidence": {"type": "string", "minLength": 1},
    "service": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "enum": ["dev", "staging", "prod"]},
    "namespace": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "enum": ["external-secrets", "vault", "cloud-secrets-manager", "sealed-secrets", "internal"]},
    "crypto": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encryptionAtRest", "kmsKey", "keyRotationDays"],
      "properties": {
        "encryptionAtRest": {"type": "boolean"},
        "kmsKey": {"type": "string", "minLength": 1},
        "keyRotationDays": {"type": "integer", "minimum": 1}
      }
    },
    "rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lastRotatedOn", "nextRotationOn", "maxAgeDays", "status"],
      "properties": {
        "lastRotatedOn": {"type": "string", "format": "date"},
        "nextRotationOn": {"type": "string", "format": "date"},
        "maxAgeDays": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["pass", "warn", "fail"]}
      }
    },
    "secrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "rotated"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "rotated": {"type": "boolean"}
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected", "scanner", "lastScanOn"],
      "properties": {
        "detected": {"type": "boolean"},
        "scanner": {"type": "string", "minLength": 1},
        "lastScanOn": {"type": "string", "format": "date"}
      }
    }
  }
}
