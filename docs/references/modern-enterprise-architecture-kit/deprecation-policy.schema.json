{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deprecation Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object",
    "owner",
    "replacement",
    "consumers",
    "noticeDate",
    "migrationDeadline",
    "rollback",
    "removalGate"
  ],
  "properties": {
    "object": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^team-[a-z0-9-]+$"
    },
    "replacement": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "noticeDate": {
      "type": "string",
      "format": "date"
    },
    "migrationDeadline": {
      "type": "string",
      "format": "date"
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "removalGate": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  }
}
