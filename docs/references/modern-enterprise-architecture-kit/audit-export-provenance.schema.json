{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Export Provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statement",
    "version",
    "owner",
    "generatedOn",
    "scope",
    "format",
    "subjects",
    "buildDefinition",
    "runDetails",
    "retention"
  ],
  "properties": {
    "statement": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "generatedOn": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureVersion",
        "package",
        "controlCount",
        "starterKitPairs"
      ],
      "properties": {
        "architectureVersion": {
          "type": "string",
          "pattern": "^V\\d+\\.\\d+$"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "controlCount": {
          "type": "integer",
          "minimum": 1
        },
        "starterKitPairs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statementType",
        "predicateType"
      ],
      "properties": {
        "statementType": {
          "type": "string",
          "minLength": 1
        },
        "predicateType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "required",
          "digestAlgorithm"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "digestAlgorithm": {
            "type": "string",
            "enum": [
              "sha256"
            ]
          }
        }
      }
    },
    "buildDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildType",
        "exportCommand",
        "verificationCommand",
        "resolvedDependenciesRequired"
      ],
      "properties": {
        "buildType": {
          "type": "string",
          "minLength": 1
        },
        "exportCommand": {
          "type": "string",
          "minLength": 1
        },
        "verificationCommand": {
          "type": "string",
          "minLength": 1
        },
        "resolvedDependenciesRequired": {
          "type": "boolean"
        }
      }
    },
    "runDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builderId",
        "sourceRepositoryRequired",
        "sourceCommitRequired"
      ],
      "properties": {
        "builderId": {
          "type": "string",
          "minLength": 1
        },
        "sourceRepositoryRequired": {
          "type": "boolean"
        },
        "sourceCommitRequired": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "reviewOn"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "reviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
