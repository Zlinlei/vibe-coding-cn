{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Control Assessment Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report",
    "version",
    "owner",
    "assessedOn",
    "assessor",
    "scope",
    "summary",
    "controlResults",
    "findings",
    "signOff"
  ],
  "properties": {
    "report": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "assessedOn": {
      "type": "string",
      "format": "date"
    },
    "assessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "independence",
        "method"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "type": "string",
          "enum": [
            "independent-review",
            "self-assessment",
            "external-audit"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureVersion",
        "controlCatalog",
        "controlCount",
        "evidenceMap",
        "auditExportManifest"
      ],
      "properties": {
        "architectureVersion": {
          "type": "string",
          "pattern": "^V\\d+\\.\\d+$"
        },
        "controlCatalog": {
          "type": "string",
          "minLength": 1
        },
        "controlCount": {
          "type": "integer",
          "minimum": 1
        },
        "evidenceMap": {
          "type": "string",
          "minLength": 1
        },
        "auditExportManifest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "assessedControls",
        "passedControls",
        "failedControls",
        "openFindings",
        "blockingFindings",
        "residualRisk"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "assessedControls": {
          "type": "integer",
          "minimum": 1
        },
        "passedControls": {
          "type": "integer",
          "minimum": 0
        },
        "failedControls": {
          "type": "integer",
          "minimum": 0
        },
        "openFindings": {
          "type": "integer",
          "minimum": 0
        },
        "blockingFindings": {
          "type": "integer",
          "minimum": 0
        },
        "residualRisk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        }
      }
    },
    "controlResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "testedOn",
          "assessor",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CTRL-[A-Z0-9-]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "testedOn": {
            "type": "string",
            "format": "date"
          },
          "assessor": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "controlId",
          "severity",
          "status",
          "owner",
          "remediation",
          "dueDate"
        ],
        "properties": {
          "finding": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "controlId": {
            "type": "string",
            "pattern": "^CTRL-[A-Z0-9-]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "mitigated",
              "closed"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "closedOn": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "signOff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "approver",
        "signedOn",
        "nextAssessmentOn"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "signedOn": {
          "type": "string",
          "format": "date"
        },
        "nextAssessmentOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
