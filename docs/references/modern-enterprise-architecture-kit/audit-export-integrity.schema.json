{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit Export Integrity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "version",
    "owner",
    "generatedOn",
    "algorithm",
    "scope",
    "outputs",
    "verification",
    "tamperEvidence",
    "retention"
  ],
  "properties": {
    "manifest": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^V\\d+\\.\\d+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "generatedOn": {
      "type": "string",
      "format": "date"
    },
    "algorithm": {
      "type": "string",
      "enum": [
        "sha256"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureVersion",
        "package",
        "controlCount",
        "starterKitPairs"
      ],
      "properties": {
        "architectureVersion": {
          "type": "string",
          "pattern": "^V\\d+\\.\\d+$"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "controlCount": {
          "type": "integer",
          "minimum": 1
        },
        "starterKitPairs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "required",
          "digestRequired"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "digestRequired": {
            "type": "boolean"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result",
        "checker"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        "checker": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tamperEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "includesGeneratedOutputs",
        "includesSourceArtifacts",
        "blocksOnMismatch"
      ],
      "properties": {
        "includesGeneratedOutputs": {
          "type": "boolean"
        },
        "includesSourceArtifacts": {
          "type": "boolean"
        },
        "blocksOnMismatch": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "reviewOn"
      ],
      "properties": {
        "period": {
          "type": "string",
          "minLength": 1
        },
        "reviewOn": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
