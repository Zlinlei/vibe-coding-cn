{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy", "owner", "scope", "allowedPrefixes", "appliesTo", "approval", "validation", "expiryReview"],
  "properties": {
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "allowedPrefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "approver", "changeRecord"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "approver": {
          "type": "string",
          "minLength": 1
        },
        "changeRecord": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultDecision", "unknownFieldBehavior", "checker"],
      "properties": {
        "defaultDecision": {
          "type": "string",
          "enum": ["reject", "warn"]
        },
        "unknownFieldBehavior": {
          "type": "string",
          "enum": ["fail", "warn"]
        },
        "checker": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expiryReview": {
      "type": "string",
      "format": "date"
    }
  }
}
