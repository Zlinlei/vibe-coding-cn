{
  "version": "V2.9",
  "releaseDate": "2026-06-02",
  "status": "Baseline Candidate",
  "profile": "modern-enterprise-architecture-executable-controls",
  "summary": "把关键企业架构控制项映射到 schema、example 和 checker 证据，并补齐隐私影响评估、租户隔离、恢复演练、策略测试、GenAI 观测和成本分摊证据",
  "alignment": [
    {
      "source": "NIST OSCAL",
      "url": "https://pages.nist.gov/OSCAL/learn/concepts/layer/control/",
      "rationale": "采用机器可读控制目录思想，记录控制项、证据和验证入口"
    },
    {
      "source": "SLSA v1.2",
      "url": "https://slsa.dev/spec/v1.2/",
      "rationale": "供应链控制项覆盖 source、build、provenance 和 artifact evidence"
    },
    {
      "source": "NIST SSDF SP 800-218",
      "url": "https://csrc.nist.gov/pubs/sp/800/218/final",
      "rationale": "安全开发控制项覆盖设计、构建、测试、发布和漏洞响应"
    },
    {
      "source": "OpenFeature Specification",
      "url": "https://openfeature.dev/specification/",
      "rationale": "发布开关控制项覆盖 flag evaluation、context、tracking、kill switch 和渐进式交付"
    },
    {
      "source": "OpenLineage",
      "url": "https://openlineage.io/docs/",
      "rationale": "运行血缘控制项覆盖 job、run、dataset、inputs、outputs 和事件证据"
    },
    {
      "source": "OWASP LLM / Agentic AI",
      "url": "https://genai.owasp.org/",
      "rationale": "AI 威胁模型控制项覆盖 prompt injection、敏感信息泄露、过度代理和工具风险"
    },
    {
      "source": "CNCF Platforms White Paper",
      "url": "https://tag-app-delivery.cncf.io/whitepapers/platforms/",
      "rationale": "平台产品指标控制项覆盖平台即产品、Golden Path、开发者体验和认知负载"
    },
    {
      "source": "NIST Privacy Framework",
      "url": "https://www.nist.gov/privacy-framework",
      "rationale": "隐私控制项覆盖数据处理目的、主体权利、删除传播、授权基础和隐私影响评估"
    },
    {
      "source": "Kubernetes Multi-tenancy / Resource Quotas",
      "url": "https://kubernetes.io/docs/concepts/security/multi-tenancy/",
      "rationale": "租户边界控制项覆盖 namespace、ServiceAccount、NetworkPolicy、ResourceQuota 和准入策略"
    },
    {
      "source": "OpenTelemetry GenAI Semantic Conventions",
      "url": "https://opentelemetry.io/docs/specs/semconv/gen-ai/",
      "rationale": "GenAI 观测控制项覆盖模型、Token、工具调用、RAG、成本和 trace 属性"
    },
    {
      "source": "OpenCost",
      "url": "https://opencost.io/docs/",
      "rationale": "成本分摊控制项覆盖 Kubernetes 成本归集、标签覆盖、未分摊成本和优化证据"
    }
  ],
  "controls": [
    {
      "id": "CTRL-ARCH-VERSION-001",
      "category": "version-governance",
      "title": "架构版本和索引同步必须可证明",
      "statement": "当前架构版本、发布状态、starter kit pair 清单和索引提及必须由机器可读清单驱动。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-version.json",
        "scripts/check-modern-architecture-kit.py"
      ],
      "schemaRequirements": [],
      "exampleRequirements": [],
      "checkerEvidence": [
        "validate_version_manifest",
        "starterKit.pairs must match checker PAIR_NAMES order"
      ]
    },
    {
      "id": "CTRL-ARCH-RELIABILITY-001",
      "category": "reliability",
      "title": "生产服务必须声明可靠性等级和恢复目标",
      "statement": "生产服务必须声明 tier、RTO、RPO、on-call、错误预算策略和演练证据。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/service.schema.json",
        "docs/references/modern-enterprise-architecture-kit/service.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/service.schema.json",
          "required": ["tier", "reliability"],
          "nestedRequired": {
            "reliability": ["rto", "rpo", "onCall", "errorBudgetPolicy", "drillEvidence"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/service.example.yaml",
          "fields": ["tier", "reliability.rto", "reliability.rpo", "reliability.onCall", "reliability.drillEvidence"]
        }
      ],
      "checkerEvidence": [
        "service.tier must match domain.sloTier"
      ]
    },
    {
      "id": "CTRL-ARCH-DATA-GOVERNANCE-001",
      "category": "data-governance",
      "title": "数据产品必须声明治理、审计和成本责任",
      "statement": "数据产品必须声明消费者、保留期、访问策略、审计、AI 使用策略、成本 owner 和 SLO。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/data-product.schema.json",
        "docs/references/modern-enterprise-architecture-kit/data-product.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/data-product.schema.json",
          "required": ["tier", "consumers", "retention", "accessPolicy", "audit", "aiUsage", "cost", "slo"],
          "nestedRequired": {
            "quality": ["completeness", "validity", "uniqueness", "accuracy"],
            "accessPolicy": ["policy", "approvalRequired"],
            "audit": ["enabled", "logRetention"],
            "cost": ["owner", "allocationTag"],
            "slo": ["freshness", "availability"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/data-product.example.yaml",
          "fields": ["consumers", "retention", "accessPolicy.policy", "audit.enabled", "aiUsage.disallowed", "cost.owner", "slo.freshness"]
        }
      ],
      "checkerEvidence": [
        "data-product.consumers must match data-product.lineage.downstream",
        "data-product.cost.owner must match data-product.owner",
        "data-product.slo.freshness must match data-product.freshness"
      ]
    },
    {
      "id": "CTRL-ARCH-AI-RUNTIME-001",
      "category": "ai-governance",
      "title": "AI 产品必须声明运行控制、预算和降级路径",
      "statement": "AI 产品必须声明模型版本、SLO、预算、降级、供应商策略、数据使用策略和专用 runbook。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/ai-product.schema.json",
        "docs/references/modern-enterprise-architecture-kit/ai-product.example.yaml",
        "docs/references/modern-enterprise-architecture-kit/ai-tool-contract.schema.json"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/ai-product.schema.json",
          "required": ["slo", "budget", "fallback", "providerPolicy", "dataUsePolicy", "runbook"],
          "nestedRequired": {
            "model": ["gatewayRoute", "approvedModel", "modelVersion"],
            "slo": ["taskCompletionRate", "groundedAnswerRate", "toolErrorRate", "p95LatencyMs"],
            "budget": ["monthlyUsd", "costPerSuccessfulTaskUsd", "owner"],
            "fallback": ["degradedMode", "humanHandoff", "rollbackPrompt"],
            "providerPolicy": ["logRetention", "dataTrainingOptOut", "crossBorderReview"],
            "dataUsePolicy": ["allowed", "disallowed"],
            "runbook": ["incident", "rollback"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/ai-product.example.yaml",
          "fields": ["model.approvedModel", "slo.groundedAnswerRate", "budget.owner", "fallback.humanHandoff", "providerPolicy.dataTrainingOptOut", "runbook.incident"]
        }
      ],
      "checkerEvidence": [
        "ai-product.tools.requiresHumanApproval must match ai-tool-contract.runtimeControls.requiresHumanApproval",
        "ai-product.tools.riskLevel must match ai-tool-contract.riskTier mapping",
        "ai-product.budget.owner must match ai-product.owner"
      ]
    },
    {
      "id": "CTRL-ARCH-GITOPS-SECURITY-001",
      "category": "gitops-runtime-security",
      "title": "GitOps 生产期望状态必须声明运行安全基线",
      "statement": "生产 GitOps 契约必须声明 ServiceAccount、Pod 安全、网络策略、镜像验签策略、HPA、PDB 和配置引用。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/gitops-deployment.schema.json",
        "docs/references/modern-enterprise-architecture-kit/gitops-deployment.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/gitops-deployment.schema.json",
          "required": ["serviceAccount", "security", "scaling", "availability", "configRefs", "policy"],
          "nestedRequired": {
            "security": ["podSecurity", "networkPolicy", "imageVerificationPolicy"],
            "scaling": ["hpa", "minReplicas", "maxReplicas", "metric"],
            "availability": ["podDisruptionBudget", "multiZone"],
            "configRefs": ["configMaps", "secrets"],
            "policy": ["requiresSignedImage", "requiresProvenance", "requiresSbom"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/gitops-deployment.example.yaml",
          "fields": ["serviceAccount", "security.imageVerificationPolicy", "scaling.hpa", "availability.podDisruptionBudget", "configRefs.secrets"]
        }
      ],
      "checkerEvidence": [
        "gitops-deployment.serviceAccount must match service.service",
        "prod gitops-deployment.policy.{field} must be true",
        "gitops-deployment.scaling.maxReplicas must be >= minReplicas"
      ]
    },
    {
      "id": "CTRL-ARCH-SUPPLY-CHAIN-001",
      "category": "supply-chain-security",
      "title": "供应链证明必须覆盖源码、构建、制品、漏洞和 Scorecard",
      "statement": "供应链证明必须覆盖 source control、SLSA、SBOM、provenance、签名、透明日志、漏洞扫描、Scorecard 和验签证据。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/supply-chain-attestation.schema.json",
        "docs/references/modern-enterprise-architecture-kit/supply-chain-attestation.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/supply-chain-attestation.schema.json",
          "required": ["sourceControl", "slsa", "sbom", "provenance", "signature", "transparencyLog", "vulnerability", "scorecard", "verification"],
          "nestedRequired": {
            "sourceControl": ["branchProtection", "reviewRequired", "signedCommitRequired"],
            "vulnerability": ["scan", "criticalOpen", "highOpen", "remediationSla"],
            "scorecard": ["report", "minimumScore", "actualScore"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/supply-chain-attestation.example.yaml",
          "fields": ["sourceControl.branchProtection", "slsa.level", "sbom.location", "vulnerability.criticalOpen", "scorecard.actualScore", "verification.result"]
        }
      ],
      "checkerEvidence": [
        "passing supply-chain-attestation must have zero critical vulnerabilities",
        "passing supply-chain-attestation must have zero high vulnerabilities",
        "supply-chain-attestation.scorecard.actualScore must be >= minimumScore"
      ]
    },
    {
      "id": "CTRL-ARCH-PRODUCTION-READINESS-001",
      "category": "production-readiness",
      "title": "生产就绪门禁必须结构化证据、阻断规则和豁免策略",
      "statement": "生产就绪门禁必须声明结构化 evidence、blocking rule、waiver policy、verification command 和过期时间。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/production-readiness.schema.json",
        "docs/references/modern-enterprise-architecture-kit/production-readiness.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/production-readiness.schema.json",
          "required": ["requiredEvidence", "blockingRules", "waiverPolicy", "verification", "expiry"],
          "nestedRequired": {
            "waiverPolicy": ["allowed", "requiresException", "maxDays"],
            "verification": ["command", "report"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/production-readiness.example.yaml",
          "fields": ["requiredEvidence", "blockingRules", "waiverPolicy.requiresException", "verification.command", "expiry"]
        }
      ],
      "checkerEvidence": [
        "validate_pair"
      ]
    },
    {
      "id": "CTRL-ARCH-SCHEMA-STRICT-001",
      "category": "schema-strictness",
      "title": "Starter Kit schema 必须拒绝未知字段",
      "statement": "所有 starter kit schema 的对象结构必须显式设置 additionalProperties=false，示例中出现未声明字段必须被 checker 阻断。",
      "requiredArtifacts": [
        "scripts/check-modern-architecture-kit.py",
        "docs/references/modern-enterprise-architecture-kit/README.md"
      ],
      "schemaRequirements": [],
      "exampleRequirements": [],
      "checkerEvidence": [
        "additionalProperties must be false for strict starter kit schemas",
        "unexpected field"
      ]
    },
    {
      "id": "CTRL-ARCH-EXTENSION-POLICY-001",
      "category": "schema-extension-governance",
      "title": "严格 schema 必须配套受控扩展策略",
      "statement": "企业自定义字段必须通过受控前缀、审批记录和默认拒绝策略进入 schema，不允许用未知字段绕过治理。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/extension-policy.schema.json",
        "docs/references/modern-enterprise-architecture-kit/extension-policy.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/extension-policy.schema.json",
          "required": ["allowedPrefixes", "approval", "validation", "expiryReview"],
          "nestedRequired": {
            "approval": ["required", "approver", "changeRecord"],
            "validation": ["defaultDecision", "unknownFieldBehavior", "checker"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/extension-policy.example.yaml",
          "fields": ["allowedPrefixes", "approval.required", "approval.changeRecord", "validation.defaultDecision", "validation.unknownFieldBehavior"]
        }
      ],
      "checkerEvidence": [
        "extension-policy.validation.defaultDecision must be reject",
        "extension-policy.validation.unknownFieldBehavior must be fail",
        "extension-policy.allowedPrefixes must include x-company-"
      ]
    },
    {
      "id": "CTRL-ARCH-FEATURE-FLAG-001",
      "category": "progressive-delivery",
      "title": "生产变更必须声明发布开关和 Kill Switch",
      "statement": "高风险生产变更必须声明 Feature Flag、评估上下文、灰度策略、成功指标、Kill Switch、SLO 燃尽回滚和曝光事件。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/feature-flag-control.schema.json",
        "docs/references/modern-enterprise-architecture-kit/feature-flag-control.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/feature-flag-control.schema.json",
          "required": ["flag", "service", "provider", "evaluation", "rollout", "guardrails", "observability", "expiresOn"],
          "nestedRequired": {
            "evaluation": ["sdk", "defaultVariant", "targetingKey", "context"],
            "rollout": ["strategy", "initialPercent", "maxPercent"],
            "guardrails": ["killSwitch", "rollbackOnSloBurn", "freezeOnIncident"],
            "observability": ["exposureEvent", "dashboard"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/feature-flag-control.example.yaml",
          "fields": ["flag", "provider", "evaluation.targetingKey", "rollout.strategy", "guardrails.killSwitch", "observability.exposureEvent"]
        }
      ],
      "checkerEvidence": [
        "feature-flag-control.service must match service.service",
        "feature-flag-control.guardrails.killSwitch must be true",
        "feature-flag-control.guardrails.rollbackOnSloBurn must be true"
      ]
    },
    {
      "id": "CTRL-ARCH-AI-THREAT-MODEL-001",
      "category": "ai-security",
      "title": "AI 产品必须声明威胁模型和红队证据",
      "statement": "AI 产品必须声明 OWASP LLM / Agentic AI 对齐、MCP 工具边界、Prompt Injection 测试、工具同意、人工确认、出站限制、红队结果和残余风险接受。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/ai-threat-model.schema.json",
        "docs/references/modern-enterprise-architecture-kit/ai-threat-model.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/ai-threat-model.schema.json",
          "required": ["standard", "scope", "risks", "controls", "redTeam", "residualRisk"],
          "nestedRequired": {
            "standard": ["llmTop10", "agenticTop10", "mcpSpec"],
            "scope": ["tools", "dataSources"],
            "controls": ["toolConsentRequired", "humanApprovalRequired", "egressRestricted", "promptInjectionTests"],
            "redTeam": ["dataset", "lastRun", "result"],
            "residualRisk": ["level", "acceptedBy", "expiresOn"]
          }
        }
      ],
      "exampleRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/ai-threat-model.example.yaml",
          "fields": ["standard.llmTop10", "standard.agenticTop10", "scope.tools", "controls.toolConsentRequired", "redTeam.result", "residualRisk.acceptedBy"]
        }
      ],
      "checkerEvidence": [
        "ai-threat-model.aiProduct must match ai-product.aiProduct",
        "ai-threat-model.scope.tools must include ai-tool-contract.tool",
        "ai-threat-model.controls.toolConsentRequired must be true",
        "ai-threat-model.controls.humanApprovalRequired must match ai-tool-contract.runtimeControls.requiresHumanApproval"
      ]
    },
    {
      "id": "CTRL-ARCH-LINEAGE-EVIDENCE-001",
      "category": "data-lineage",
      "title": "数据产品必须有运行血缘事件证据",
      "statement": "数据产品必须提供可审计的运行血缘事件，覆盖 producer job、run state、输入数据集、输出数据集、schema、质量证据和血缘后端。",
      "requiredArtifacts": [
        "docs/references/modern-enterprise-architecture-kit/lineage-event.schema.json",
        "docs/references/modern-enterprise-architecture-kit/lineage-event.example.yaml"
      ],
      "schemaRequirements": [
        {
          "path": "docs/references/modern-enterprise-architecture-kit/lineage-event.schema.json",
